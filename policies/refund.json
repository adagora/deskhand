{
  "format": "qdl-intent",
  "version": 1,
  "name": "CityWheels cancellation refund v2",
  "thought": "Rental refund is 100 % at 48 hours or more before the start, 50 % from 24 to under 48 hours, 0 % under 24 hours, rounded half up to a cent. The deposit always comes back for a cancellable booking; the booking fee never does. Only confirmed bookings can be cancelled. Amounts are counted in cents so the rounding is exact. A storm claim never reaches this rule: the desk sends it to the staff before any quote.",
  "inputs": [
    { "id": "rentalMinor", "name": "rentalMinor", "type": { "kind": "number", "unit": "cent", "min": 0 } },
    { "id": "bookingFeeMinor", "name": "bookingFeeMinor", "type": { "kind": "number", "unit": "cent", "min": 0 } },
    { "id": "depositMinor", "name": "depositMinor", "type": { "kind": "number", "unit": "cent", "min": 0 } },
    { "id": "hoursBefore", "name": "hoursBefore", "type": { "kind": "number", "unit": "h" } },
    { "id": "cancellable", "name": "cancellable", "type": { "kind": "boolean" } },
    { "id": "paidWithVoucher", "name": "paidWithVoucher", "type": { "kind": "boolean" } },
    { "id": "percentFull", "value": 100, "type": { "kind": "number", "unit": "percent", "min": 0 } },
    { "id": "percentHalf", "value": 50, "type": { "kind": "number", "unit": "percent", "min": 0 } },
    { "id": "percentNone", "value": 0, "type": { "kind": "number", "unit": "percent", "min": 0 } },
    { "id": "halfUpBias", "value": 50, "type": { "kind": "number", "unit": "cent*percent", "min": 0 } },
    { "id": "centsPerEur", "value": 100, "type": { "kind": "number", "unit": "cent*EUR^-1", "min": 0 } },
    { "id": "noCent", "value": 0, "type": { "kind": "number", "unit": "cent", "min": 0 } },
    { "id": "no", "value": false, "type": { "kind": "boolean" } }
  ],
  "steps": [
    { "id": "atLeast48h", "op": "compare", "inputs": ["hoursBefore"], "params": { "operator": "gte", "value": 48 } },
    { "id": "atLeast24h", "op": "compare", "inputs": ["hoursBefore"], "params": { "operator": "gte", "value": 24 } },
    { "id": "latePercent", "op": "choose", "inputs": ["atLeast24h", "percentHalf", "percentNone"], "params": {} },
    { "id": "timePercent", "op": "choose", "inputs": ["atLeast48h", "percentFull", "latePercent"], "params": {} },
    { "id": "share", "op": "choose", "inputs": ["cancellable", "timePercent", "percentNone"], "params": {} },
    { "id": "rentalScaled", "op": "arithmetic", "inputs": ["rentalMinor", "share"], "params": { "kind": "mul" } },
    { "id": "rentalBiased", "op": "arithmetic", "inputs": ["rentalScaled", "halfUpBias"], "params": { "kind": "add" } },
    { "id": "rentalRefundMinor", "op": "arithmetic", "inputs": ["rentalBiased", "percentFull"], "params": { "kind": "floorDiv" } },
    { "id": "depositRefundMinor", "op": "choose", "inputs": ["cancellable", "depositMinor", "noCent"], "params": {} },
    { "id": "totalMinor", "op": "arithmetic", "inputs": ["rentalRefundMinor", "depositRefundMinor"], "params": { "kind": "add" } },
    { "id": "bookingFeeKeptMinor", "op": "choose", "inputs": ["cancellable", "bookingFeeMinor", "noCent"], "params": {} },
    { "id": "rentalRefund", "op": "arithmetic", "inputs": ["rentalRefundMinor", "centsPerEur"], "params": { "kind": "div" } },
    { "id": "depositRefund", "op": "arithmetic", "inputs": ["depositRefundMinor", "centsPerEur"], "params": { "kind": "div" } },
    { "id": "bookingFeeKept", "op": "arithmetic", "inputs": ["bookingFeeKeptMinor", "centsPerEur"], "params": { "kind": "div" } },
    { "id": "total", "op": "arithmetic", "inputs": ["totalMinor", "centsPerEur"], "params": { "kind": "div" } },
    { "id": "notCancellable", "op": "compare", "inputs": ["cancellable"], "params": { "operator": "eq", "value": false } },
    { "id": "viaCard", "op": "choose", "inputs": ["paidWithVoucher", "no", "cancellable"], "params": {} },
    { "id": "viaVoucher", "op": "choose", "inputs": ["paidWithVoucher", "cancellable", "no"], "params": {} },
    { "id": "quoteToCard", "op": "action", "inputs": ["viaCard", "total"], "params": { "allowed": true, "action": "quote-refund-to-card" } },
    { "id": "quoteAsVoucher", "op": "action", "inputs": ["viaVoucher", "total"], "params": { "allowed": true, "action": "quote-refund-as-voucher" } },
    { "id": "explainNoRefund", "op": "action", "inputs": ["notCancellable", "total"], "params": { "allowed": true, "action": "explain-no-refund" } }
  ],
  "outputs": ["share", "rentalRefund", "depositRefund", "bookingFeeKept", "total", "quoteToCard", "quoteAsVoucher", "explainNoRefund"]
}
