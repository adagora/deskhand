# CityWheels help desk. Copy the names you need into a .env file.
# Use plain KEY=value lines. Leave the key lines empty in this example.
# The CLI reads .env from the current directory and from parent directories,
# so the repository-root .env is enough.

# fake, openai, or gemini.
# If this line is omitted, openai is used when OPENAI_API_KEY is set,
# otherwise gemini when GEMINI_API_KEY is set, otherwise fake.
CITYWHEELS_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
